{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parameter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "defaultValue", "minimum", "maximum", "step", "unit", "editable", "requiresResourceRebuild", "runtimeUpdate", "animatable", "dependsOn", "constraints", "choices"],
  "properties": {
    "type": { "enum": ["boolean", "integer", "float", "enum", "color", "vector2", "vector3", "vector4", "gradient", "texture", "duration", "curve", "object"] },
    "defaultValue": {},
    "minimum": { "type": ["number", "null"] },
    "maximum": { "type": ["number", "null"] },
    "step": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "unit": { "type": "string" },
    "editable": { "type": "boolean" },
    "requiresResourceRebuild": { "type": "boolean" },
    "runtimeUpdate": { "type": "boolean" },
    "animatable": { "type": "boolean" },
    "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op"],
        "oneOf": [{ "required": ["parameter"] }, { "required": ["value"] }],
        "properties": {
          "op": { "enum": ["eq", "neq", "lt", "lte", "gt", "gte"] },
          "parameter": { "$ref": "#/$defs/key" },
          "value": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "choices": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": { "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$" } }
}
