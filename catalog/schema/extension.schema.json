{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extension.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "namespace", "minCatalogVersion", "maxCatalogVersion", "materials", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "minCatalogVersion": { "$ref": "material.schema.json#/$defs/version" },
    "maxCatalogVersion": { "$ref": "material.schema.json#/$defs/version" },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "material.schema.json" } },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    }
  }
}
