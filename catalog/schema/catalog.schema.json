{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "presetSchemaVersion", "contentHash", "migrations", "materials"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "$ref": "material.schema.json#/$defs/version" },
    "presetSchemaVersion": { "$ref": "material.schema.json#/$defs/version" },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "material.schema.json" } },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["materialId", "fromRevision", "toRevision", "fromSchemaVersion", "toSchemaVersion", "rename"],
        "properties": {
          "materialId": { "$ref": "material.schema.json#/$defs/id" },
          "fromRevision": { "$ref": "material.schema.json#/$defs/version" },
          "toRevision": { "$ref": "material.schema.json#/$defs/version" },
          "fromSchemaVersion": { "$ref": "material.schema.json#/$defs/version" },
          "toSchemaVersion": { "$ref": "material.schema.json#/$defs/version" },
          "rename": { "type": "object", "propertyNames": { "$ref": "parameter.schema.json#/$defs/key" }, "additionalProperties": { "$ref": "parameter.schema.json#/$defs/key" } }
        }
      }
    }
  }
}
