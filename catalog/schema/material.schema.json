{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "materialRevision", "name", "localizedNames", "aliases", "category", "tags", "description", "visualCharacteristics", "useCases", "sourceRepository", "sourceRevision", "sourceFiles", "publicSymbols", "publicEntrypoint", "requiredCapabilities", "requiredResources", "parameters", "nativePreviewId", "webRendererId", "rendererVersion", "previewScene", "renderPassDependencies", "loaderCompatibility", "webCompatibility", "validationStatus", "validationEvidence", "deprecated", "replacementId"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "materialRevision": { "$ref": "#/$defs/version" },
    "name": { "$ref": "#/$defs/text" },
    "localizedNames": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } },
    "aliases": { "$ref": "#/$defs/texts" },
    "category": { "$ref": "#/$defs/text" },
    "tags": { "$ref": "#/$defs/texts" },
    "description": { "$ref": "#/$defs/text" },
    "visualCharacteristics": { "$ref": "#/$defs/texts" },
    "useCases": { "$ref": "#/$defs/texts" },
    "sourceRepository": { "type": "string", "pattern": "^https://" },
    "sourceRevision": { "$ref": "#/$defs/text" },
    "sourceFiles": { "$ref": "#/$defs/texts", "minItems": 1 },
    "publicSymbols": { "$ref": "#/$defs/texts", "minItems": 1 },
    "publicEntrypoint": { "$ref": "#/$defs/text" },
    "requiredCapabilities": { "$ref": "#/$defs/ids" },
    "requiredResources": { "$ref": "#/$defs/ids" },
    "parameters": { "type": "object", "propertyNames": { "$ref": "parameter.schema.json#/$defs/key" }, "additionalProperties": { "$ref": "parameter.schema.json" } },
    "defaultValues": { "type": "object" },
    "nativePreviewId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "webRendererId": { "type": ["string", "null"] },
    "rendererVersion": { "anyOf": [{ "$ref": "#/$defs/version" }, { "type": "null" }] },
    "previewScene": { "type": ["string", "null"] },
    "renderPassDependencies": { "$ref": "#/$defs/texts" },
    "loaderCompatibility": { "$ref": "compatibility.schema.json" },
    "webCompatibility": { "enum": ["native-only", "web-approximation", "web-verified", "web-unsupported"] },
    "validationStatus": { "enum": ["source-verified", "automated", "client-verified", "unverified"] },
    "validationEvidence": { "$ref": "#/$defs/texts" },
    "deprecated": { "type": "boolean" },
    "replacementId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  }
}
